--- a/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c
+++ b/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c
@@ -85,6 +85,7 @@
 #include <core/locks.h>
 #include <pex.h>
 #include <acpidsmguids.h>
+#include <nvacpitypes.h>
 #include "kernel/gpu/intr/intr.h"
 
 #include <gpu/mem_sys/kern_mem_sys.h>
@@ -1253,6 +1254,28 @@
         }
     }
 
+    //
+    // NVIDIA N1x platforms answer the NVPCF _DSM only at revision 0x300, so the
+    // 2x/1x queries above fail. Ask for the 3x supported-functions list too.
+    //
+    portMemSet(pNvpcfParams, 0, sizeof(*pNvpcfParams));
+    pNvpcfParams->gpuId = pGpu->gpuId;
+    pNvpcfParams->nvpcfFunc = ACPI_DSM_FUNCTION_NVPCF_3X;
+    pNvpcfParams->subFunc =
+        NVPCF0100_CTRL_CONFIG_DSM_3X_FUNC_NVPCF_READ_PLATFORM_WRITE_SUPPORTED_FUNCTIONS;
+
+    status = pRmApi->Control(pRmApi,
+                             nv->rmapi.hClient,
+                             nv->rmapi.hClient,
+                             NV0000_CTRL_CMD_SYSTEM_NVPCF_GET_POWER_MODE_INFO,
+                             (void*)pNvpcfParams,
+                             sizeof(*pNvpcfParams));
+    if ((status == NV_OK) && (pNvpcfParams->supportedFuncs != 0))
+    {
+        ret = 1;
+        goto cleanup;
+    }
+
     ret = 0;
 
 cleanup:
