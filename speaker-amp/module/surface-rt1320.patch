+/*
+ * First load at boot/bind: wait until the card is up and the amp is idle (as
+ * the "DSP FW Update" control requires); loading during card setup leaves the
+ * DSP not running.
+ */
+static void rt1320_auto_dspfw_work(struct work_struct *work)
+{
+	struct rt1320_sdw_priv *rt1320 =
+		container_of(work, struct rt1320_sdw_priv, auto_dspfw_work.work);
+	struct snd_soc_component *component = rt1320->component;
+	int ret;
+
+	if (!component || !rt1320->hw_init || rt1320->fw_load_done)
+		return;
+
+	ret = pm_runtime_resume_and_get(component->dev);
+	if (ret < 0 && ret != -EACCES)
+		return;
+
+	if (component->card && snd_soc_card_is_instantiated(component->card) &&
+	    snd_soc_dapm_get_bias_level(snd_soc_component_to_dapm(component)) == SND_SOC_BIAS_OFF) {
+		mutex_lock(&rt1320_dspfw_mutex);
+		rt1320_dspfw_load_code(rt1320);
+		if (rt1320->fw_load_done)
+			rt1320_rae_load(rt1320);
+		mutex_unlock(&rt1320_dspfw_mutex);
+		/* attempted: a DSP that did not start won't on a retry either */
+		rt1320->auto_dspfw_tries = 10;
+	}
+
+	if (ret >= 0) {
+		pm_runtime_mark_last_busy(component->dev);
+		pm_runtime_put_autosuspend(component->dev);
+	}
+
+	if (!rt1320->fw_load_done && ++rt1320->auto_dspfw_tries < 10)
+		schedule_delayed_work(&rt1320->auto_dspfw_work, msecs_to_jiffies(3000));
+}
+
+/*
+ * A SoundWire bus reset during the byte-wise download leaves the DSP in a state
+ * only a power cycle clears. On the Surface Laptop Ultra a boot-time service
+ * resets the bus once, 3 s after the card appears, so start well after that.
+ */
+static unsigned int auto_dspfw_delay_ms = 10000;
+module_param(auto_dspfw_delay_ms, uint, 0644);
+MODULE_PARM_DESC(auto_dspfw_delay_ms, "Delay before the first DSP FW load (ms)");
+
+static void rt1320_auto_dspfw(struct rt1320_sdw_priv *rt1320)
+{
+	if (auto_dspfw && rt1320->component && rt1320->hw_init && !rt1320->fw_load_done) {
+		rt1320->auto_dspfw_tries = 0;
+		mod_delayed_work(system_wq, &rt1320->auto_dspfw_work,
+				 msecs_to_jiffies(auto_dspfw_delay_ms));
+	}
 }
 
