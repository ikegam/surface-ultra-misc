#!/usr/bin/python3 -I
# Standby-DRIPS residency/usage counters from SPM SYSRAM (the _LPI counter registers of
# \_SB.SLPI: residency 0x12F1A0, usage 0x12F1A8). Read-only. Run as root.
import mmap, os, struct
fd = os.open('/dev/mem', os.O_RDONLY | os.O_SYNC)
m = mmap.mmap(fd, 4096, mmap.MAP_SHARED, mmap.PROT_READ, offset=0x12F000)
for name, off in (('DRIPS', 0x1A0), ('PGKSL', 0x180), ('PGKLL', 0x190), ('C0 DSUOFF', 0x160), ('C1 DSUOFF', 0x170)):
    res, use = struct.unpack_from('<Q', m, off)[0], struct.unpack_from('<Q', m, off + 8)[0]
    print(f'{name:10s} residency {res:>16d}  usage {use:>12d}')
